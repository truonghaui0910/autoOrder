<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Update"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Có bản cập nhật"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tải về và cài đặt phiên bản mới"
                android:textSize="12sp"
                android:textColor="#E3F2FD" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Đóng"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/bg_view_mode_option">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hiện tại"
                    android:textSize="11sp"
                    android:textColor="#78909C"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/txtCurrentVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#607D8B"
                    tools:text="1.2.0"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="→"
                app:tint="#90A4AE" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mới nhất"
                    android:textSize="11sp"
                    android:textColor="#1E88E5"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/txtNewVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1E88E5"
                    tools:text="1.2.1"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="4dp"
            android:textSize="12sp"
            android:textColor="#78909C"
            tools:text="Kích thước: 15.4 MB"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="6dp"
            android:text="Thay đổi"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#607D8B"
            android:letterSpacing="0.05"
            android:textAllCaps="true" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="220dp"
            android:background="@drawable/bg_view_mode_option"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtChangelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#37474F"
                android:lineSpacingExtra="3dp"
                tools:text="- Sửa lỗi X\n- Thêm tính năng Y"
                xmlns:tools="http://schemas.android.com/tools" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnLater"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="90dp"
                android:text="Để sau"
                android:textColor="#607D8B"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_ghost" />

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="130dp"
                android:layout_marginStart="10dp"
                android:text="Tải &amp; Cài"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
