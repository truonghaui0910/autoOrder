<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiết đơn"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#E3F2FD" />
        </LinearLayout>

        <ImageView
            android:id="@+id/paidIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Trạng thái thanh toán"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Đóng"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Tên người gửi" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:scaleType="centerCrop"
                    android:contentDescription="Avatar" />

                <EditText
                    android:id="@+id/etName"
                    style="@style/OrderFieldInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:paddingStart="4dp"
                    android:paddingHorizontal="4dp"
                    android:inputType="textPersonName"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Các món order" />

            <LinearLayout
                android:id="@+id/itemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/itemsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:text="Chưa có món, bấm + Thêm món"
                android:textSize="13sp"
                android:textColor="#90A4AE"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAddItem"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="+ Thêm món"
                android:textColor="#1E88E5"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_outline" />

            <LinearLayout
                android:id="@+id/totalRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/txtTotalLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tổng"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:id="@+id/total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0₫"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1E88E5" />
            </LinearLayout>

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Địa chỉ nhận hàng" />

            <EditText
                android:id="@+id/etAddr"
                style="@style/OrderFieldInput"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:gravity="top|start" />

            <HorizontalScrollView
                android:id="@+id/addrSavedScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/addrSavedRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Số điện thoại" />

            <EditText
                android:id="@+id/etPhone"
                style="@style/OrderFieldInput"
                android:inputType="phone"
                android:singleLine="true" />

            <HorizontalScrollView
                android:id="@+id/phoneSavedScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/phoneSavedRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Ghi chú đơn" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etOrderNote"
                    style="@style/OrderFieldInput"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:paddingEnd="28dp"
                    android:hint="Ghi chú chung cho cả đơn (giờ giao, lời nhắn...)" />

                <ImageView
                    android:id="@+id/btnClearNote"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_close"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Xoá ghi chú"
                    android:visibility="gone"
                    app:tint="#212121" />
            </FrameLayout>

            <CheckBox
                android:id="@+id/chkCopyWithPrices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="Hiện giá khi copy"
                android:textSize="12sp"
                android:textColor="#37474F" />

            <LinearLayout
                android:id="@+id/copySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:padding="12dp"
                android:background="#F5F9FF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nội dung copy"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E88E5" />

                <TextView
                    android:id="@+id/copyContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:textColor="#212121"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnDeleteOrder"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="80dp"
            android:text="Xoá"
            android:textColor="#C62828"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_ghost" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="100dp"
            android:text="Copy"
            android:textColor="#1E88E5"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:minWidth="100dp"
            android:text="Lưu"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</LinearLayout>
