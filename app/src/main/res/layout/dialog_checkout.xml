<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chốt đơn"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chọn hội thoại &amp; ngày để lọc đơn hàng"
                android:textSize="12sp"
                android:textColor="#E3F2FD" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_minimize"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Thu gọn"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Đóng"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/OrderFieldLabel"
                        android:text="Nhóm Zalo" />

                    <Spinner
                        android:id="@+id/spChat"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/OrderFieldLabel"
                        android:text="Ngày" />

                    <TextView
                        android:id="@+id/tvDate"
                        style="@style/OrderFieldInput"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawablePadding="6dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:weightSum="3">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp">

                    <Button
                        android:id="@+id/btnReadMessages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="1. Đọc tin nhắn"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_primary" />

                    <ProgressBar
                        android:id="@+id/pbReadMessages"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />
                </FrameLayout>

                <Button
                    android:id="@+id/btnAnalyze"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:text="2. Phân tích"
                    android:textColor="#1E88E5"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_outline" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp">

                    <Button
                        android:id="@+id/btnSaveAll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="3. Lưu đơn"
                        android:textColor="#1E88E5"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_outline" />

                    <ProgressBar
                        android:id="@+id/pbSaveAll"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#1E88E5"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="12sp"
                android:textColor="#90A4AE"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:hint="Tìm trong tin nhắn của tôi..."
                android:textSize="12sp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/filterScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnFilterConfirmed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Đã xác nhận"
                            android:textSize="10sp"
                            android:textColor="#90A4AE"
                            android:background="@drawable/bg_input_field"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnFilterUnconfirmed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Chưa xác nhận"
                            android:textSize="10sp"
                            android:textColor="#90A4AE"
                            android:background="@drawable/bg_input_field"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnFilterFreeship"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Free ship"
                            android:textSize="10sp"
                            android:textColor="#90A4AE"
                            android:background="@drawable/bg_input_field"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnFilterDone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Đã làm xong"
                            android:textSize="10sp"
                            android:textColor="#90A4AE"
                            android:background="@drawable/bg_input_field"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnFilterBooked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Đã book ship"
                            android:textSize="10sp"
                            android:textColor="#90A4AE"
                            android:background="@drawable/bg_input_field"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnFilterUnmapped"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Chưa map"
                    android:textSize="10sp"
                    android:textColor="#90A4AE"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterUnsaved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Chưa lưu"
                    android:textSize="10sp"
                    android:textColor="#90A4AE"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterUnpaid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Chưa TT"
                    android:textSize="10sp"
                    android:textColor="#90A4AE"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMessagesLabel"
                style="@style/OrderFieldLabel"
                android:text="Tin nhắn gần nhất"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/messagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
