<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_bottom_bar"
    android:elevation="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="3dp"
    android:weightSum="5">

    <LinearLayout
        android:id="@+id/btnHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_message"
            android:tint="#1976D2"
            android:contentDescription="WebView" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Chat"
            android:textColor="#37474F"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnReload"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_refresh"
            android:tint="#1976D2"
            android:contentDescription="Tải lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Tải lại"
            android:textColor="#37474F"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnDump"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_scan"
            android:tint="#1976D2"
            android:contentDescription="Quét" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Quét"
            android:textColor="#37474F"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnInbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_inbox"
            android:tint="#1976D2"
            android:contentDescription="Tin" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="0 tin"
            android:textColor="#1976D2"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_settings"
            android:tint="#1976D2"
            android:contentDescription="Cài đặt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Cài đặt"
            android:textColor="#37474F"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
