<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sửa Zalo chat"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <ImageView
            android:id="@+id/btnDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Đóng"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Tên" />

            <EditText
                android:id="@+id/etName"
                style="@style/OrderFieldInput"
                android:singleLine="true" />

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Zalo ID" />

            <TextView
                android:id="@+id/txtZaloId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:textSize="13sp"
                android:textColor="#607D8B" />

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Loại chat" />

            <Spinner
                android:id="@+id/spChatType"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Trạng thái" />

            <Spinner
                android:id="@+id/spStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Số điện thoại (mỗi dòng 1 số)" />

            <EditText
                android:id="@+id/etPhone"
                style="@style/OrderFieldInput"
                android:inputType="phone|textMultiLine"
                android:minLines="2"
                android:gravity="top|start" />

            <TextView
                style="@style/OrderFieldLabel"
                android:text="Địa chỉ (mỗi dòng 1 địa chỉ)" />

            <EditText
                android:id="@+id/etAddress"
                style="@style/OrderFieldInput"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="80dp"
            android:text="Xoá"
            android:textColor="#C62828"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_ghost" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="100dp"
            android:text="Lưu"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</LinearLayout>
