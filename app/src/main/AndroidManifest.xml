<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.autoorder">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoOrder">

        <activity
            android:name=".ChatWebActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MessagesActivity"
            android:exported="false"
            android:label="Tin nhắn đã lưu"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Cài đặt"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ProductsActivity"
            android:exported="false"
            android:label="Sản phẩm"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".OrdersActivity"
            android:exported="false"
            android:label="Đơn hàng"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ZaloChatsActivity"
            android:exported="false"
            android:label="Zalo chat"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".BankAccountsActivity"
            android:exported="false"
            android:label="Tài khoản nhận tiền"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".WebMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
